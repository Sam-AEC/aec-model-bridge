{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(python scripts/version.py check)"
    ],
    "deny": [
      "Read(./THIRD_PARTY_NOTICES.md)",
      "Read(./packages/mcp-server-revit/uv.lock)"
    ]
  }
}
